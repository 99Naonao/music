<page-meta
  page-style="{{pageMetaStyle}}"
  background-color="{{mbPageBg}}"
  background-color-top="{{mbNavBg}}"
  background-color-bottom="{{mbPageBgBottom}}"
  root-background-color="{{mbPageBgBottom}}"
  background-color-content="{{mbPageBgBottom}}"
/>
<mb-bottom-safe />
<view class="mb-page mb-theme-{{mbTheme}}" style="{{pageShellStyle}}">
  <view class="mb-page-chrome" style="{{pageBgStyle}}"></view>
  <view class="mb-page-bg" style="{{pageBgStyle}}"></view>
  <view class="mb-page-body mj-detail" wx:if="{{product}}">
    <view class="mj-detail-notice">
      <text class="mj-detail-notice-title">如何购买</text>
      <text class="mj-detail-notice-text">复制商品信息，在微信搜索「{{mallName}}」即可查找该商品。</text>
    </view>

    <image
      class="mj-detail-img"
      src="{{product.image}}"
      mode="aspectFill"
      binderror="onCoverError"
    />

    <view class="mj-detail-info">
      <text class="mj-detail-name">{{product.name}}</text>
      <text class="mj-detail-desc" wx:if="{{product.description}}">{{product.description}}</text>
      <text class="mj-detail-id">商品编号：{{product.goodsId}}</text>
    </view>

    <view class="mj-detail-actions">
      <button class="mj-detail-btn mj-detail-btn--primary" bindtap="onTapCopySearch">
        复制商品信息去搜索
      </button>
      <text
        class="mj-detail-voucher-link"
        wx:if="{{hasVoucher}}"
        bindtap="onTapViewVoucher"
      >查看二维码</text>
    </view>
  </view>

  <view class="mj-detail-loading" wx:elif="{{loading}}">
    <text>加载中…</text>
  </view>
  <product-qrcode-modal id="productQrcodeModal" />
</view>
