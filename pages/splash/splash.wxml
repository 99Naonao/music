<page-meta
  page-style="{{pageMetaStyle}}"
  background-color="{{mbPageBg}}"
  background-color-top="{{mbNavBg}}"
  background-color-bottom="{{mbPageBgBottom}}"
  root-background-color="{{mbPageBgBottom}}"
/>
<view class="splash-shell" style="{{splashShellStyle}}"></view>
<view
  class="splash-page splash-page--{{variant}} {{splashFullBleed ? 'splash-page--full' : ''}}"
  style="{{pageShellStyle}}"
  bindtap="onTapSkip"
>
  <image
    wx:if="{{splashFullBleed}}"
    class="splash-bg splash-bg--full"
    src="{{heroSrc}}"
    mode="aspectFill"
    show-menu-by-longpress="{{false}}"
    binderror="onHeroImageError"
  />
  <view wx:if="{{splashFullBleed}}" class="splash-scrim"></view>

  <view
    wx:if="{{splashFullBleed}}"
    class="splash-body splash-body--full {{showContent ? 'splash-body-in' : ''}}"
  >
    <view class="splash-copy">
      <text class="splash-title" style="color: {{splashTitleColor}};">{{splashTitle}}</text>
      <text class="splash-subtitle" style="color: {{splashSubtitleColor}};">{{splashSubtitle}}</text>
      <text class="splash-slogan" style="color: {{splashSloganColor}};">{{splashSlogan}}</text>
    </view>
  </view>

  <view wx:if="{{!splashFullBleed}}" class="splash-body {{showContent ? 'splash-body-in' : ''}}">
    <view class="splash-hero-wrap">
      <image
        class="splash-hero"
        src="{{heroSrc}}"
        mode="aspectFit"
        show-menu-by-longpress="{{false}}"
        binderror="onHeroImageError"
      />
    </view>
    <view class="splash-copy">
      <text class="splash-title" style="color: {{splashTitleColor}};">{{splashTitle}}</text>
      <text class="splash-subtitle" style="color: {{splashSubtitleColor}};">{{splashSubtitle}}</text>
      <text class="splash-slogan" style="color: {{splashSloganColor}};">{{splashSlogan}}</text>
    </view>
  </view>
</view>
