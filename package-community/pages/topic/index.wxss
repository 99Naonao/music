.topic-page {
  min-height: 100vh;
  }

/* 顶部标题栏 */
.topic-header {
  background: var(--mb-gradient-cta-to-night);
  padding: 40rpx 30rpx 30rpx;
  color: var(--mb-text-primary);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.topic-name {
  font-size: 40rpx;
  font-weight: 700;
}

.publish-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.15);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

.publish-btn:active {
  background: rgba(255,255,255,0.25);
}

.publish-icon {
  width: 28rpx;
  height: 28rpx;
}

.publish-text {
  font-size: 26rpx;
  color: var(--mb-text-primary);
}

.topic-count {
  font-size: 26rpx;
  opacity: 0.8;
}

/* 话题筛选 */
.topic-filter {
  background: rgba(255,255,255,0.03);
  border-bottom: 1rpx solid var(--mb-border-subtle);
  padding: 20rpx 0;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: flex;
  gap: 16rpx;
  padding: 0 30rpx;
}

.filter-item {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  background: var(--mb-card-bg);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--mb-text-secondary);
}

.filter-item.active {
  background: var(--mb-mint-30);
  color: var(--mb-mint);
  border: 1rpx solid var(--mb-mint-40);
}

.filter-item:active {
  opacity: 0.7;
}

/* 帖子列表 */
.post-list {
  padding: 20rpx 30rpx;
  padding-bottom: 40rpx;
}

.post-card {
  background: var(--mb-card-bg);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.post-card:active {
  background: var(--mb-card-bg);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--mb-card-bg);
  flex-shrink: 0;
}

.card-user {
  margin-left: 16rpx;
  flex: 1;
}

.card-name {
  display: block;
  font-size: 28rpx;
  color: var(--mb-text-primary);
  font-weight: 500;
}

.card-time {
  display: block;
  font-size: 22rpx;
  color: var(--mb-text-muted);
  margin-top: 4rpx;
}

.card-topic {
  display: inline-block;
  font-size: 24rpx;
  color: var(--mb-mint);
  background: var(--mb-mint-12);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.card-text {
  display: block;
  font-size: 28rpx;
  color: var(--mb-text-primary);
  line-height: 1.6;
  margin-bottom: 20rpx;
  word-break: break-all;
}

.card-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.card-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: var(--mb-card-bg);
}

.card-img.single {
  width: 100%;
  max-height: 400rpx;
  height: auto;
}

.card-footer {
  display: flex;
  gap: 40rpx;
  align-items: center;
  border-top: 1rpx solid rgba(255,255,255,0.06);
  padding-top: 20rpx;
}

.card-stat {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--mb-text-muted);
}

.stat-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 加载/空状态 */
.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: var(--mb-text-muted);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 60rpx;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--mb-text-muted);
  text-align: center;
}
