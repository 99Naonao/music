.config-page {
  position: relative;
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.config-scroll {
  flex: none;
  width: 100%;
  box-sizing: border-box;
}

.config-page-bg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.mb-theme-dawn .config-page-bg {
  background: linear-gradient(135deg, #d1e9ff 0%, #e8f4ff 42%, #f7faff 72%, #ffffff 100%);
}

.mb-theme-night .config-page-bg {
  background:
    radial-gradient(ellipse 120% 60% at 50% -8%, rgba(111, 143, 207, 0.35) 0%, transparent 55%),
    linear-gradient(180deg, #202b48 0%, #2d3a5c 45%, #1a2238 100%);
}

.config-page-body {
  position: relative;
  z-index: 1;
  padding: 30rpx;
  /* padding-bottom 由 scrollContentBottomPx 动态设置，避让底部固定按钮 */
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--mb-border-subtle);
  transition: all 0.3s;
}

.step-dot.active {
  background: linear-gradient(135deg, #7fb3a3 0%, #6f8fcf 100%);
  width: 48rpx;
  border-radius: 8rpx;
}

/* 卡片 */
.config-page-body .card {
  background: var(--mb-card-bg);
  border: 1rpx solid var(--mb-card-border);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(30, 58, 95, 0.06);
}

.mb-theme-night .config-page-body .card {
  box-shadow: none;
}

.config-page-body .card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.card-title-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.card-required {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--mb-accent, #c9a86c);
}

.instrument-scroll {
  white-space: nowrap;
}

.instrument-list {
  display: inline-flex;
}

.instrument-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 28rpx;
  margin-right: 16rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 16rpx;
  border: 2rpx solid var(--mb-card-border);
  min-width: 120rpx;
}

.mb-theme-night .instrument-item {
  background: var(--mb-card-bg);
}

.instrument-item.selected {
  border-color: rgba(111, 143, 207, 0.55);
  background: rgba(111, 143, 207, 0.18);
}

.instrument-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 12rpx;
}

.instrument-name {
  font-size: 24rpx;
  color: var(--mb-text-primary);
}

.scroll-hint {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--mb-mist-blue);
  font-size: 36rpx;
  pointer-events: none;
  opacity: 0.8;
  animation: configPulse 2s infinite;
}

@keyframes configPulse {
  0%,
  100% {
    opacity: 0.6;
  }
  50% {
    opacity: 1;
  }
}

.frequency-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.frequency-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 10rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 16rpx;
  border: 2rpx solid var(--mb-card-border);
  text-align: center;
}

.mb-theme-night .frequency-item {
  background: var(--mb-card-bg);
}

.frequency-item.selected {
  border-color: rgba(111, 143, 207, 0.55);
  background: rgba(111, 143, 207, 0.18);
}

.frequency-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6f8fcf 0%, #7fb3a3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--mb-text-primary);
  font-weight: 600;
  margin-bottom: 10rpx;
}

.frequency-label {
  font-size: 24rpx;
  color: var(--mb-text-primary);
  font-weight: 500;
}

.duration-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.duration-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 16rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 16rpx;
  border: 2rpx solid var(--mb-card-border);
}

.mb-theme-night .duration-item {
  background: var(--mb-card-bg);
}

.duration-item.selected {
  border-color: rgba(111, 143, 207, 0.55);
  background: rgba(111, 143, 207, 0.18);
}

.duration-label {
  font-size: 28rpx;
  color: var(--mb-text-primary);
  font-weight: 500;
}

.frequency-help {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(111, 143, 207, 0.08);
}

.frequency-help-text {
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--mb-text-secondary);
}

.duration-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--mb-text-muted);
  line-height: 1.5;
}

.bpm-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.bpm-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 16rpx;
  border: 2rpx solid var(--mb-card-border);
  text-align: center;
}

.mb-theme-night .bpm-item {
  background: var(--mb-card-bg);
}

.bpm-item.selected {
  border-color: rgba(111, 143, 207, 0.55);
  background: rgba(111, 143, 207, 0.18);
}

.bpm-item.highlighted {
  border-color: rgba(127, 179, 163, 0.6);
  background: rgba(127, 179, 163, 0.15);
}

.bpm-label {
  font-size: 22rpx;
  color: var(--mb-text-muted);
  margin-bottom: 4rpx;
}

.bpm-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--mb-text-primary);
}

.bpm-unit {
  font-size: 20rpx;
  color: var(--mb-text-muted);
}

.bpm-recommend {
  font-size: 18rpx;
  color: #2d5a8e;
  background: rgba(111, 143, 207, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-top: 6rpx;
}

.mb-theme-night .bpm-recommend {
  color: var(--mb-mint);
  background: var(--mb-mint-15);
}

.expert-tips {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(111, 143, 207, 0.1);
  border: 1rpx solid rgba(111, 143, 207, 0.22);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.mb-theme-night .expert-tips {
  background: rgba(255, 215, 0, 0.1);
  border-color: rgba(255, 215, 0, 0.3);
}

.tips-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.tips-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--mb-text-secondary);
  line-height: 1.5;
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 12rpx 30rpx;
  box-sizing: border-box;
  background: transparent;
  border-top: none;
}

.mb-theme-night .bottom-action {
  background: transparent;
  border-top: none;
}

.bottom-action .btn-primary {
  width: 100%;
  margin: 0;
  background: var(--mb-btn-primary, var(--mb-gradient-cta));
  color: #fff;
  border: none;
  border-radius: 48rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
  box-shadow: 0 8rpx 24rpx var(--mb-btn-shadow, rgba(111, 143, 207, 0.35));
}

.bottom-action .btn-primary::after {
  border: none;
}

.config-page-body .btn-primary {
  background: var(--mb-btn-primary, var(--mb-gradient-cta));
  color: #fff;
  border: none;
  border-radius: 48rpx;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx var(--mb-btn-shadow, rgba(111, 143, 207, 0.35));
}

.config-page-body .btn-primary::after {
  border: none;
}
