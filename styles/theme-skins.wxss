/**
 * 主题皮肤 · CSS 变量由 page-meta 注入（与 utils/theme.js 一致）
 * 全站页面壳：mb-page / mb-page-bg / *-page-bg
 */

.mb-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
}

.mb-page-bg,
.create-home-bg,
[class$='-page-bg'] {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  background: var(--mb-gradient-page);
}

.mb-page-body {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
}
