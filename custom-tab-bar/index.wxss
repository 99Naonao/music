.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  height: calc(96rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #ffffff;
  border-top: 1rpx solid rgba(107, 122, 140, 0.12);
}

.mb-theme-night.tab-bar {
  background: #1a2238;
  border-top-color: rgba(255, 255, 255, 0.08);
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 8rpx;
}

.tab-bar-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-bar-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #6b7a8c;
}

.mb-theme-night .tab-bar-text {
  color: rgba(245, 245, 240, 0.55);
}

.tab-bar-item--active .tab-bar-text {
  color: #2d5a8e;
  font-weight: 600;
}

.mb-theme-night .tab-bar-item--active .tab-bar-text {
  color: #8eb4e8;
}
