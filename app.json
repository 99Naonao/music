{
  "pages": [
    "pages/splash/splash",
    "pages/create/create",
    "pages/create/config",
    "pages/create/gift",
    "pages/communites/communites",
    "pages/library/library",
    "pages/mine/mine",
    "pages/follow/list",
    "pages/logs/logs"
  ],
  "subPackages": [
    {
      "root": "package-create",
      "pages": [
        "pages/create/ai",
        "pages/create/tracks",
        "pages/create/generating",
        "pages/create/complete",
        "pages/create/player",
        "pages/create/card-pick",
        "pages/create/card-edit",
        "pages/create/share",
        "pages/create/gift"
      ],
      "name": "create-ext"
    },
    {
      "root": "package-community",
      "pages": [
        "pages/post/detail",
        "pages/post/create",
        "pages/topic/index",
        "pages/rankings/index"
      ],
      "name": "community"
    },
    {
      "root": "package-mall",
      "pages": [
        "pages/mall/index",
        "pages/mall/product-detail",
        "pages/mianjia/index",
        "pages/mianjia/detail",
        "pages/points/history",
        "pages/points/tasks"
      ],
      "name": "mall"
    },
    {
      "root": "package-profile",
      "pages": [
        "pages/profile/works",
        "pages/profile/posts",
        "pages/profile/settings",
        "pages/profile/account-security",
        "pages/notifications/index",
        "pages/profile/edit",
        "pages/profile/play-history",
        "pages/profile/favorites",
        "pages/profile/gift-inbox",
        "pages/profile/downloads"
      ],
      "name": "profile-ext"
    },
    {
      "root": "package-support",
      "pages": [
        "pages/help/index",
        "pages/help/faq",
        "pages/help/guide",
        "pages/help/feedback",
        "pages/help/contact",
        "pages/help/about"
      ],
      "name": "support"
    }
  ],
  "window": {
    "navigationBarTitleText": "眠音盒",
    "navigationBarBackgroundColor": "#e1f0ff",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#0f0b14",
    "backgroundColorContent": "#0f0b14",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "custom": true,
    "color": "#6b7a8c",
    "selectedColor": "#2d5a8e",
    "backgroundColor": "#1a1a2e",
    "borderStyle": "black",
    "list": [
      {
        "iconPath": "static/home.png",
        "selectedIconPath": "static/home_selected.png",
        "text": "首页",
        "pagePath": "pages/create/create"
      },
      {
        "iconPath": "static/ai.png",
        "selectedIconPath": "static/ai_selected.png",
        "text": "AI生成",
        "pagePath": "pages/create/config"
      },
      {
        "iconPath": "static/friend.png",
        "selectedIconPath": "static/friend_selected.png",
        "text": "盒友圈",
        "pagePath": "pages/communites/communites"
      },
      {
        "iconPath": "static/mine.png",
        "selectedIconPath": "static/mine_selected.png",
        "text": "我的",
        "pagePath": "pages/mine/mine"
      }
    ]
  },
  "preloadRule": {
    "pages/mine/mine": {
      "network": "all",
      "packages": ["profile-ext", "support"]
    },
    "pages/communites/communites": {
      "network": "all",
      "packages": ["community"]
    },
    "pages/create/create": {
      "network": "all",
      "packages": ["profile-ext", "community", "create-ext"]
    },
    "pages/create/config": {
      "network": "all",
      "packages": ["create-ext"]
    },
    "pages/create/gift": {
      "network": "all",
      "packages": ["create-ext"]
    }
  },
  "style": "v2",
  "renderer": "webview",
  "componentFramework": "glass-easel",
  "usingComponents": {
    "mb-bottom-safe": "/components/mb-bottom-safe/index"
  },
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
