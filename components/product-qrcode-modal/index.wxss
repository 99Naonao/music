.pqm-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10050;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  background: rgba(30, 58, 95, 0);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.25s ease, background 0.25s ease;
}

.pqm-mask--show {
  background: rgba(30, 58, 95, 0.48);
  pointer-events: auto;
  opacity: 1;
}

.pqm-card {
  width: 100%;
  max-width: 620rpx;
  padding: 40rpx 32rpx 36rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  text-align: center;
  background: #fff;
  border: 1rpx solid rgba(30, 58, 95, 0.08);
  box-shadow: 0 24rpx 64rpx rgba(30, 58, 95, 0.18);
  transform: scale(0.9) translateY(24rpx);
  opacity: 0;
  transition: transform 0.28s cubic-bezier(0.34, 1.2, 0.64, 1), opacity 0.25s ease;
}

.pqm-card--show {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.pqm-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1e3a5f;
  margin-bottom: 12rpx;
}

.pqm-name {
  font-size: 24rpx;
  color: rgba(30, 58, 95, 0.62);
  line-height: 1.5;
  margin-bottom: 24rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.pqm-img-wrap {
  width: 420rpx;
  height: 420rpx;
  margin: 0 auto;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fafafa;
  border: 1rpx solid rgba(30, 58, 95, 0.08);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pqm-img {
  width: 100%;
  height: 100%;
}

.pqm-hint {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: rgba(30, 58, 95, 0.45);
}

.pqm-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  margin: 32rpx 0 0;
  padding: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #1e3a5f;
  background: #f5f7fa;
  border: 1rpx solid rgba(30, 58, 95, 0.1);
  border-radius: 40rpx;
}

.pqm-btn::after {
  border: none;
}

.pqm-btn:active {
  opacity: 0.85;
}
