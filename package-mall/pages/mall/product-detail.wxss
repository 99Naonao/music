.product-detail { background: var(--mb-gradient-page); min-height: 100vh; padding-bottom: 140rpx; }
.detail-img { width: 100%; height: 500rpx; background: var(--mb-card-bg); }
.detail-info { background: var(--mb-card-bg); padding: 30rpx; margin-bottom: 16rpx; }
.detail-name { display: block; font-size: 36rpx; font-weight: 600; color: var(--mb-text-primary); margin-bottom: 16rpx; }
.detail-points { display: flex; align-items: baseline; gap: 8rpx; margin-bottom: 20rpx; }
.point-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; display: block; }
.point-num { font-size: 40rpx; color: #e6a23c; font-weight: 700; }
.point-label { font-size: 24rpx; color: var(--mb-text-muted); }
.detail-desc { display: block; font-size: 28rpx; color: var(--mb-text-secondary); line-height: 1.6; }
.detail-bottom { position: fixed; bottom: 0; left: 0; right: 0; background: var(--mb-card-bg); padding: 20rpx 30rpx; display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid rgba(255,255,255,0.06); }
.my-points { display: flex; align-items: center; gap: 8rpx; }
.mp-label { font-size: 26rpx; color: var(--mb-text-secondary); }
.mp-value { font-size: 32rpx; color: #e6a23c; font-weight: 600; }
.exchange-btn { width: 240rpx; height: 80rpx; background: var(--mb-gradient-cta-to-night-h); color: #fff; font-size: 30rpx; border-radius: 40rpx; }
.exchange-btn::after { border: none; }
