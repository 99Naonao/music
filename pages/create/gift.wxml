<view class="gift-relay">
  <view wx:if="{{loading && !error}}" class="gift-relay-box">
    <text class="gift-relay-title">正在打开贺卡…</text>
    <text class="gift-relay-sub">请稍候</text>
  </view>
  <view wx:if="{{error}}" class="gift-relay-box">
    <text class="gift-relay-title">{{error}}</text>
    <button class="gift-relay-btn" bindtap="onRetry">重试</button>
    <button class="gift-relay-btn ghost" bindtap="goHome">返回首页</button>
  </view>
</view>
