<page-meta
  page-style="{{pageMetaStyle}}"
  background-color="{{mbPageBg}}"
  background-color-top="{{mbNavBg}}"
  background-color-bottom="{{mbPageBg}}"
  root-background-color="{{mbPageBg}}"
/>
<mb-bottom-safe />
<view class="mb-page mb-theme-{{mbTheme}}" style="{{pageShellStyle}}">
  <view class="mb-page-chrome" style="{{pageBgStyle}}"></view>
  <view class="mb-page-bg" style="{{pageBgStyle}}"></view>
  <view class="mb-page-body product-detail">
  <image class="detail-img" src="{{product.image}}" mode="aspectFill"/>
  <view class="detail-info">
    <text class="detail-name">{{product.name}}</text>
    <view class="detail-points">
      <image class="point-icon" src="/static/icon_star.png" mode="aspectFit"/>
      <text class="point-num">{{product.points}}</text>
      <text class="point-label">积分</text>
    </view>
    <text class="detail-desc">{{product.desc}}</text>
  </view>
  <view class="detail-bottom">
    <view class="my-points">
      <text class="mp-label">我的积分:</text>
      <text class="mp-value">{{userPoints}}</text>
    </view>
    <button class="exchange-btn" bindtap="exchange">立即兑换</button>
  </view>
  </view>
  <product-qrcode-modal id="productQrcodeModal" />
</view>
