<page-meta
  page-style="{{pageMetaStyle}}"
  background-color="{{mbPageBg}}"
  background-color-top="{{mbNavBg}}"
  background-color-bottom="{{mbPageBgBottom}}"
  root-background-color="{{mbPageBgBottom}}"
  background-color-content="{{mbPageBgBottom}}"
/>
<mb-bottom-safe />
<view class="mb-page mb-theme-{{mbTheme}}" style="{{pageShellStyle}}">
  <view class="mb-page-chrome" style="{{pageBgStyle}}"></view>
  <view class="mb-page-bg" style="{{pageBgStyle}}"></view>
  <view class="mb-page-body library-container">
  <view class="library-header">
    <text class="library-title">疗愈曲库</text>
    <view class="search-bar">
      <input class="search-input" placeholder="搜索音乐名称" placeholder-class="search-placeholder" bindinput="onSearch"/>
    </view>
  </view>

  <view class="category-tabs">
    <view class="cat-tab {{activeCategory==index?'active':''}}" wx:for="{{categories}}" wx:key="id" bindtap="switchCategory" data-index="{{index}}">
      <image class="cat-emoji" src="{{item.img || item.icon}}" mode="aspectFit"/>
      <text class="cat-name">{{item.name}}</text>
    </view>
  </view>

  <view class="music-list">
    <view class="music-item" wx:for="{{musicList}}" wx:key="id" bindtap="playMusic" data-id="{{item.id}}">
      <view class="music-cover">
        <image
          wx:if="{{item.isCoverImage}}"
          class="cover-photo"
          src="{{item.img}}"
          mode="aspectFill"
        />
        <image
          wx:else
          class="cover-icon"
          src="{{item.img || item.icon}}"
          mode="aspectFit"
        />
      </view>
      <view class="music-info">
        <text class="music-title">{{item.title}}</text>
        <text class="music-desc" wx:if="{{item.description}}">{{item.description}}</text>
      </view>
      <view class="music-meta">
        <text class="meta-duration">{{item.duration}}</text>
        <view class="meta-play"><image class="meta-play-icon" src="/static/new_logo/play.png" mode="aspectFit"/> {{item.plays}}</view>
      </view>
    </view>
  </view>
  </view>
</view>
