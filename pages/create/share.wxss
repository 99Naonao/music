@import '../../styles/card-art-text-stroke.wxss';
.share-page {
  min-height: 100vh;
    padding: 20rpx 30rpx;
}

.share-gift-strip {
  text-align: center;
  margin-bottom: 16rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  /* background: var(--mb-mint-08); */
  /* border: 1rpx solid var(--mb-border-subtle); */
}

.share-gift-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  margin-bottom: 8rpx;
}

.share-gift-sub {
  display: block;
  font-size: 24rpx;
  color: var(--mb-text-muted);
  line-height: 1.45;
}

.share-load-error {
  margin: 0 0 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(231, 76, 60, 0.08);
  border: 1rpx solid rgba(231, 76, 60, 0.2);
  text-align: center;
}

.share-load-error-text {
  display: block;
  font-size: 26rpx;
  color: #c0392b;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.share-load-error-retry {
  display: inline-block;
  padding: 12rpx 40rpx;
  font-size: 26rpx;
  color: var(--mb-accent, #568fd1);
  background: #fff;
  border-radius: 999rpx;
  border: 1rpx solid rgba(86, 143, 209, 0.35);
  line-height: 1.4;
}

.share-load-error-retry::after {
  border: none;
}

/* 音乐播放器 */
.share-player-section {
  text-align: center;
}

.share-cover-container {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto 30rpx;
}

.share-cover {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin: 0 auto;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.35);
}

.share-cover-img {
  width: 100%;
  height: 100%;
}

.share-cover-default {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--mb-mint-40), var(--mb-mist-30));
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-cover-default-icon {
  width: 100rpx;
  height: 100rpx;
}

.share-cover-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
}

.share-cover:hover .share-cover-overlay,
.share-cover-overlay {
  opacity: 1;
}

.share-play-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--mb-gradient-cta);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-btn-icon {
  width: 48rpx;
  height: 48rpx;
}

.share-music-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  margin-bottom: 10rpx;
}

.share-music-info {
  display: block;
  font-size: 26rpx;
  color: var(--mb-text-secondary);
  margin-bottom: 20rpx;
}

.share-progress {
  width: 100%;
  height: 8rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.share-progress-bar {
  height: 100%;
  background: var(--mb-gradient-cta-h);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.share-time {
  display: flex;
  justify-content: space-between;
  color: var(--mb-text-muted);
  font-size: 24rpx;
}

/* 贺卡预览 */
.share-card-section {
  margin-bottom: 40rpx;
}

.share-card {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  min-height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.share-card.with-art-bg {
  padding: 0;
  min-height: 0;
  width: 100%;
  background: transparent;
  display: block;
}

.share-card-art-frame {
  position: relative;
  width: 100%;
  line-height: normal;
  overflow: visible;
}

.share-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #2E8B57 0%, #4682B4 100%);
  z-index: 1;
}

.share-card-bg-photo {
  width: 100%;
  display: block;
  vertical-align: top;
  border-radius: 16rpx;
}

.share-card.style-2 .share-card-bg {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.share-card.style-3 .share-card-bg {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.share-card.style-4 .share-card-bg {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.share-card-content {
  position: relative;
  z-index: 2;
  text-align: center;
  color: #fff;
  width: 100%;
}

.share-card-content--art {
  position: absolute;
  z-index: 2;
  overflow: visible;
  box-sizing: border-box;
  line-height: 1.45;
}

.share-card-content--art .share-card-message-wrap {
  display: block;
  width: 100%;
  line-height: 1.45;
  color: #4a3f38;
  text-align: left;
}

.share-card-content--art .share-card-message-line {
  display: block;
  width: 100%;
  line-height: 1.45;
  word-break: normal;
}

.share-card-message-gap {
  display: block;
  width: 100%;
  height: 0.65em;
}

.share-card-message-wrap--gradient {
  display: block;
  width: 100%;
  margin-bottom: 30rpx;
  line-height: 1.6;
  font-weight: 500;
}

.share-card-message-wrap--gradient .share-card-message-line {
  display: block;
  width: 100%;
  line-height: 1.6;
  word-break: break-all;
}

.share-to-slot {
  position: absolute;
  z-index: 3;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.share-to-line {
  width: 100%;
  font-weight: 600;
  color: #5c4a3a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.share-card-to {
  font-size: 28rpx;
  margin-bottom: 30rpx;
  opacity: 0.9;
}

.share-card-to text {
  font-weight: 600;
}

.share-card-message {
  font-size: 36rpx;
  line-height: 1.6;
  margin-bottom: 30rpx;
  font-weight: 500;
  text-indent: 2em;
}

.share-card-from {
  font-size: 26rpx;
  opacity: 0.8;
}

.share-card-from text {
  font-weight: 500;
}

/* 底部分享操作区 */
.share-footer {
  width: 100%;
  box-sizing: border-box;
  margin-top: 8rpx;
  padding-top: 8rpx;
}

.share-points-hint {
  display: block;
  width: 100%;
  margin-bottom: 12rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--mb-text-muted);
}

.share-footer-actions {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  gap: 20rpx;
}

/* 收礼页：我也要制作（满宽，置于分享按钮上方） */
.share-footer-invite {
  width: 100%;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.share-btn-invite-create {
  display: block;
  width: 100% !important;
  max-width: 100%;
  height: auto;
  min-height: 96rpx;
  margin: 0;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--mb-mint), #5a9a88);
  color: #fff;
  border: none;
  box-shadow: 0 8rpx 24rpx var(--mb-mint-25, rgba(127, 179, 163, 0.35));
}

.share-btn-invite-create::after {
  border: none;
}

.share-invite-btn-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.share-invite-btn-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #fff;
}

.share-invite-btn-sub {
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.25;
  color: rgba(255, 255, 255, 0.88);
}

.share-btn-invite-create:active {
  opacity: 0.9;
  transform: scale(0.99);
}

/* 与上方两按钮同宽：外层满宽，button 块级铺满 */
.share-footer-prev {
  width: 100%;
  margin-top: 20rpx;
  box-sizing: border-box;
}

.share-btn-prev-full {
  display: block;
  width: 100% !important;
  max-width: 100%;
  height: 88rpx;
  margin: 0;
  padding: 0;
  line-height: 88rpx;
  text-align: center;
  box-sizing: border-box;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  background: var(--mb-card-bg, rgba(255, 255, 255, 0.92));
  border: 2rpx solid var(--mb-mint, #7fb3a3);
  box-shadow: 0 6rpx 20rpx rgba(46, 139, 87, 0.12);
  letter-spacing: 1rpx;
}

.share-btn-prev-full::after {
  border: none;
}

.mb-theme-night .share-btn-prev-full {
  background: var(--mb-card-bg);
  border-color: var(--mb-mint-40, rgba(127, 179, 163, 0.55));
  color: var(--mb-text-primary);
}

.share-btn-prev-full:active {
  opacity: 0.88;
  transform: scale(0.99);
}

.share-btn {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 44rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.2;
  box-sizing: border-box;
  overflow: hidden;
}

.share-btn::after {
  border: none;
}

/* 主操作：分享小程序卡片 */
.share-btn--primary {
  background: linear-gradient(135deg, var(--mb-mint), #5a9a88);
  color: #fff;
  border: none;
  box-shadow: 0 8rpx 24rpx var(--mb-mint-25, rgba(127, 179, 163, 0.35));
}

/* 次操作：返回首页 */
.share-btn--outline {
  background: var(--mb-card-bg, rgba(255, 255, 255, 0.12));
  color: var(--mb-mint);
  border: 2rpx solid var(--mb-mint-40, rgba(127, 179, 163, 0.45));
}

.mb-theme-night .share-btn--outline {
  color: var(--mb-text-primary);
  border-color: var(--mb-border-subtle);
}
