.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  height: 96rpx;
  box-sizing: content-box;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 8rpx;
}

.tab-bar-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-bar-text {
  margin-top: 4rpx;
  font-size: 20rpx;
}
