.create-home {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 有播放条时由 JS 动态设置 padding-bottom（TabBar + 播放条高度） */
.create-home--has-player {
  padding-bottom: 0;
}

.create-home-bg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.mb-theme-dawn .create-home-bg {
  background: var(--mb-gradient-page);
}

.mb-theme-night .create-home-bg {
  background: var(--mb-gradient-page);
}

.create-home-content {
  position: relative;
  z-index: 1;
  padding: 0 32rpx 32rpx;
}

/* 顶部问候 */
.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-top: 32rpx;
  padding-bottom: 28rpx;
}

.home-header-text {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.home-greeting {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--mb-text-primary);
  line-height: 1.25;
  margin-bottom: 8rpx;
}

.home-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--mb-text-secondary);
  line-height: 1.45;
}

.home-header-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
  padding-top: 8rpx;
}

.home-icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--mb-card-bg);
  border: 1rpx solid var(--mb-card-border);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(30, 58, 95, 0.06);
}

.mb-theme-night .home-icon-btn {
  box-shadow: none;
}

.home-icon-img {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.85;
}

/* AI 智能生成卡 */
.ai-card {
  margin-bottom: 36rpx;
  border-radius: 28rpx;
  background: var(--mb-card-bg);
  border: 1rpx solid var(--mb-card-border);
  box-shadow: 0 8rpx 32rpx rgba(30, 58, 95, 0.08);
  overflow: hidden;
}

.mb-theme-night .ai-card {
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.2);
}

.ai-card-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 28rpx 36rpx 36rpx;
  min-height: 200rpx;
}

.ai-card-copy {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.ai-card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--mb-text-primary);
  margin-bottom: 10rpx;
}

.ai-card-desc {
  display: block;
  font-size: 26rpx;
  color: var(--mb-text-secondary);
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.ai-card-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: var(--mb-btn-primary, var(--mb-gradient-cta));
  border-radius: 40rpx;
  box-shadow: 0 6rpx 20rpx var(--mb-btn-shadow, rgba(111, 143, 207, 0.35));
}

.ai-card-mascot-wrap {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  overflow: hidden;
}

.ai-card-mascot {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background-color: transparent;
}

/* 眠家产品入口 */
.mianjia-entry {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
  padding: 28rpx 72rpx 28rpx 32rpx;
  border-radius: 24rpx;
  background: var(--mb-mint-08);
  border: 1rpx solid var(--mb-border-subtle);
  box-sizing: border-box;
}

.mianjia-entry-close {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.mianjia-entry-close-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.55;
}

.mianjia-entry-close:active .mianjia-entry-close-icon {
  opacity: 0.85;
}

.mianjia-entry:active {
  opacity: 0.85;
}

.mianjia-entry-text {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.mianjia-entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  margin-bottom: 8rpx;
}

.mianjia-entry-desc {
  display: block;
  font-size: 24rpx;
  color: var(--mb-text-muted);
  line-height: 1.45;
}

.mianjia-entry-link {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--mb-mint);
  font-weight: 500;
}

/* 推荐音景 */
.soundscape-section {
  margin-bottom: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-head-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--mb-text-primary);
}

.section-head-more {
  font-size: 26rpx;
  color: var(--mb-mist-blue);
}

.soundscape-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}

.soundscape-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 16rpx;
  width: 100%;
}

/* 与改版前单条列表一致：整行满宽，行内两卡各占一半 */
.soundscape-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: var(--mb-card-bg);
  border: 1rpx solid var(--mb-card-border);
  box-shadow: 0 4rpx 16rpx rgba(30, 58, 95, 0.05);
}

.soundscape-item:active {
  opacity: 0.92;
  transform: scale(0.995);
}

.soundscape-thumb {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: var(--mb-accent-soft, rgba(111, 143, 207, 0.12));
}

.soundscape-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.soundscape-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.soundscape-meta {
  display: block;
  font-size: 24rpx;
  color: var(--mb-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 首页疗愈曲库（官方曲目） */
.home-library-section {
  margin-bottom: 28rpx;
}

.home-library-hint {
  padding: 28rpx 8rpx;
  font-size: 26rpx;
  color: var(--mb-text-muted);
  text-align: center;
}

.home-library-scroll {
  width: 100%;
  white-space: nowrap;
}

.home-library-inner {
  display: inline-flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 4rpx 0 8rpx;
}

.home-library-card {
  display: inline-flex;
  flex-direction: column;
  width: 220rpx;
  flex-shrink: 0;
  padding: 20rpx 18rpx;
  border-radius: 24rpx;
  background: var(--mb-card-bg);
  border: 1rpx solid var(--mb-card-border);
  box-shadow: 0 4rpx 16rpx rgba(30, 58, 95, 0.05);
  box-sizing: border-box;
}

.home-library-card:active {
  opacity: 0.92;
  transform: scale(0.99);
}

.home-library-cover {
  width: 100%;
  height: 120rpx;
  border-radius: 18rpx;
  background: var(--mb-accent-soft, rgba(111, 143, 207, 0.1));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  overflow: hidden;
}

.home-library-icon {
  width: 56rpx;
  height: 56rpx;
}

.home-library-photo {
  width: 100%;
  height: 100%;
}

.home-library-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-library-meta {
  display: block;
  font-size: 22rpx;
  color: var(--mb-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 辅助入口 */
.home-shortcuts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.shortcut-item {
  flex: 1;
  min-width: 28%;
  padding: 20rpx 12rpx;
  text-align: center;
  border-radius: 20rpx;
  background: var(--mb-card-bg);
  border: 1rpx solid var(--mb-card-border);
  font-size: 24rpx;
  color: var(--mb-text-secondary);
}

.shortcut-item:active {
  opacity: 0.9;
}

.home-footer-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--mb-text-muted);
  padding: 8rpx 0 24rpx;
}

/* 底部迷你播放条 · bottom 由 wxml 内联 px 控制，贴 Tab 栏上沿 */
.mini-player {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  z-index: 10001;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx 16rpx 24rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--mb-card-border, rgba(111, 143, 207, 0.15));
  box-shadow: 0 8rpx 32rpx rgba(30, 58, 95, 0.12);
  backdrop-filter: blur(12px);
  box-sizing: border-box;
}

.mini-player-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.mb-theme-night .mini-player {
  background: rgba(45, 58, 92, 0.92);
  border-color: var(--mb-border-subtle);
}

.mini-player-cover {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--mb-accent-soft, rgba(111, 143, 207, 0.15));
}

.mini-player-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  overflow: hidden;
}

.mini-player-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-player-status {
  display: block;
  font-size: 22rpx;
  color: var(--mb-text-muted);
  line-height: 1.4;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-player-play {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 4rpx 8rpx 12rpx;
}

.mini-player-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--mb-btn-primary);
  box-shadow: 0 6rpx 20rpx var(--mb-btn-shadow, rgba(86, 143, 209, 0.28));
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-player-triangle {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-style: solid;
  border-width: 14rpx 0 14rpx 22rpx;
  border-color: transparent transparent transparent #ffffff;
}

.mini-player-pause-bars {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mini-player-pause-bars::before,
.mini-player-pause-bars::after {
  content: '';
  width: 8rpx;
  height: 28rpx;
  background: #ffffff;
  border-radius: 2rpx;
}
