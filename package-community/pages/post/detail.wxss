.post-detail {
  min-height: 100vh;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.loading-state--inline {
  padding: 24rpx 0;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 100rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--mb-text-muted);
}

.post-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--mb-card-bg);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  margin-left: 20rpx;
}

.nickname {
  display: block;
  font-size: 30rpx;
  color: var(--mb-text-primary);
  font-weight: 500;
}

.time {
  display: block;
  font-size: 24rpx;
  color: var(--mb-text-muted);
  margin-top: 4rpx;
}

.follow-btn {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #fff;
  background: var(--mb-mint);
  border-radius: 28rpx;
}

.follow-btn--done {
  color: var(--mb-text-secondary);
  background: transparent;
  border: 1rpx solid var(--mb-border-subtle);
}

.post-delete-btn {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #c0392b;
  border: 1rpx solid rgba(192, 57, 43, 0.35);
  border-radius: 28rpx;
}

.post-topic {
  font-size: 24rpx;
  color: var(--mb-mint);
  background: var(--mb-mint-12);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.post-content {
  padding: 0 30rpx 30rpx;
}

.post-text {
  font-size: 30rpx;
  color: var(--mb-text-primary);
  line-height: 1.7;
  display: block;
  word-break: break-all;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.post-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  background: var(--mb-card-bg);
}

.post-img.single {
  width: 100%;
  max-height: 400rpx;
  height: auto;
}

/* 关联音乐 */
.music-card {
  margin: 0 30rpx 24rpx;
  background: var(--mb-mint-08);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid var(--mb-mint-15);
}

.music-card:active {
  background: var(--mb-mint-12);
}

.music-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.music-play-icon {
  width: 44rpx;
  height: 44rpx;
}

.music-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.music-label {
  font-size: 22rpx;
  color: var(--mb-mint);
}

.music-name {
  font-size: 28rpx;
  color: var(--mb-text-primary);
  margin-top: 4rpx;
}

.music-slider {
  margin: 16rpx 0 8rpx;
  padding: 0;
}

.music-time {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: var(--mb-text-muted);
}

.post-actions {
  display: flex;
  border-top: 1rpx solid rgba(255,255,255,0.06);
  border-bottom: 1rpx solid var(--mb-border-subtle);
  padding: 24rpx 0;
  margin: 0 30rpx;
}

.action-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 12rpx 0;
}

.action-item:active {
  opacity: 0.7;
}

.action-item.liked .action-count {
  color: #ff6b6b;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
}

.action-count {
  font-size: 26rpx;
  color: var(--mb-text-secondary);
}

/* 分享按钮 */
.share-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
  border-radius: 0;
  font-size: inherit;
}

.share-btn::after {
  border: none;
}

.comment-section {
  padding: 30rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
}

.comment-count {
  font-size: 24rpx;
  color: var(--mb-text-muted);
  font-weight: 400;
}

.comment-sort-picker {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: var(--mb-card-bg, rgba(255, 255, 255, 0.08));
  border: 1rpx solid var(--mb-border-subtle);
}

.comment-sort-picker:active {
  opacity: 0.75;
}

.comment-sort-label {
  font-size: 24rpx;
  color: var(--mb-text-secondary);
  font-weight: 400;
}

.comment-sort-arrow {
  font-size: 20rpx;
  color: var(--mb-text-muted);
  line-height: 1;
}

.comment-list {
  padding-bottom: 20rpx;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--mb-card-bg);
  flex-shrink: 0;
}

.comment-main {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.comment-name {
  display: block;
  font-size: 26rpx;
  color: var(--mb-text-secondary);
  font-weight: 500;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.comment-delete-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #c0392b;
  padding: 4rpx 12rpx;
}

.comment-delete-btn:active {
  opacity: 0.7;
}

.comment-delete-btn--reply {
  margin-left: 8rpx;
  align-self: flex-start;
  margin-top: 4rpx;
}

.comment-text {
  display: block;
  font-size: 28rpx;
  color: var(--mb-text-primary);
  line-height: 1.5;
}

.comment-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  gap: 16rpx;
}

.comment-time {
  font-size: 22rpx;
  color: var(--mb-text-muted);
  flex-shrink: 0;
}

.comment-reply-btn {
  font-size: 24rpx;
  color: var(--mb-mist-blue, #568fd1);
  padding: 4rpx 8rpx;
}

.comment-reply-btn:active {
  opacity: 0.7;
}

.comment-replies {
  margin-top: 16rpx;
  padding-left: 4rpx;
}

.comment-like-col {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 4rpx;
  margin-left: 12rpx;
  padding-top: 4rpx;
  min-width: 56rpx;
}

.comment-like-col--root {
  margin-left: 16rpx;
}

.comment-like-icon {
  width: 36rpx;
  height: 36rpx;
}

.comment-like-count {
  font-size: 22rpx;
  color: var(--mb-text-muted);
  line-height: 1.2;
}

.comment-like-count--on {
  color: #ff6b6b;
}

.comment-reply-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  position: relative;
}

.comment-reply-item:last-child {
  margin-bottom: 0;
}

.comment-reply-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--mb-card-bg);
  flex-shrink: 0;
}

.comment-reply-body {
  margin-left: 16rpx;
  flex: 1;
  min-width: 0;
}

.comment-reply-name {
  display: block;
  font-size: 24rpx;
  color: var(--mb-text-secondary);
  font-weight: 500;
  margin-bottom: 6rpx;
}

.comment-reply-text {
  display: block;
  font-size: 28rpx;
  color: var(--mb-text-primary);
  line-height: 1.45;
  word-break: break-all;
}

.comment-reply-foot {
  margin-top: 8rpx;
}

.replies-expand {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  padding: 8rpx 0 4rpx 64rpx;
}

.replies-expand--collapse {
  padding-left: 64rpx;
}

.replies-expand-line {
  width: 48rpx;
  height: 1rpx;
  background: var(--mb-border-subtle);
  flex-shrink: 0;
}

.replies-expand-text {
  font-size: 24rpx;
  color: var(--mb-mist-blue, #568fd1);
}

.replies-expand:active {
  opacity: 0.7;
}

.empty-comments {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--mb-text-muted);
}

/* 底部评论输入 */
.comment-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: #ffffff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(30, 58, 95, 0.1);
  box-shadow: 0 -8rpx 28rpx rgba(30, 58, 95, 0.1);
}

.mb-theme-night .comment-bar {
  background: rgba(32, 43, 72, 0.98);
  border-top-color: rgba(255, 255, 255, 0.08);
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.25);
}

.reply-hint-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}

.reply-hint-text {
  font-size: 24rpx;
  color: var(--mb-mist-blue, #568fd1);
}

.reply-hint-cancel {
  font-size: 24rpx;
  color: var(--mb-text-muted);
  padding: 8rpx;
}

.comment-bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  height: 76rpx;
  min-height: 76rpx;
  background: #f0f4fa;
  border: 1rpx solid rgba(86, 143, 209, 0.2);
  border-radius: 38rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--mb-text-primary);
  box-sizing: border-box;
}

.mb-theme-night .comment-input {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.12);
}

.input-placeholder {
  color: var(--mb-text-muted);
}

.send-btn {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 76rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  background: rgba(86, 143, 209, 0.25);
}

.send-btn.active {
  background: var(--mb-btn-primary, linear-gradient(135deg, #6f8fcf, #568fd1));
}

.send-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.send-btn:not(.active) .send-btn-text {
  color: rgba(255, 255, 255, 0.65);
}

.send-btn:active {
  opacity: 0.85;
}
