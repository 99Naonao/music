.dl-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.dl-header {
  padding: 24rpx 30rpx 16rpx;
}

.dl-count {
  font-size: 26rpx;
  color: var(--mb-text-secondary);
}

.dl-list {
  padding: 0 20rpx;
}

.dl-item {
  display: flex;
  align-items: center;
  background: var(--mb-card-bg);
  border: 1rpx solid var(--mb-card-border);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.dl-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--mb-card-bg);
}

.dl-info {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}

.dl-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--mb-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dl-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.dl-tag {
  font-size: 22rpx;
  color: var(--mb-text-muted);
  background: var(--mb-mint-08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.dl-time {
  display: block;
  font-size: 22rpx;
  color: var(--mb-text-muted);
  margin-top: 8rpx;
}

.dl-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.dl-duration {
  font-size: 22rpx;
  color: var(--mb-text-muted);
}

.dl-play-icon {
  width: 36rpx;
  height: 36rpx;
}

.dl-remove {
  font-size: 22rpx;
  color: #c0392b;
  padding: 4rpx 0;
}

.dl-empty {
  padding: 80rpx 40rpx;
  text-align: center;
}

.dl-empty-title {
  display: block;
  font-size: 30rpx;
  color: var(--mb-text-primary);
  margin-bottom: 12rpx;
}

.dl-empty-hint {
  display: block;
  font-size: 26rpx;
  color: var(--mb-text-muted);
  line-height: 1.5;
}
