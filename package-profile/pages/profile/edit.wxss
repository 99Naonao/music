.edit-container { background: var(--mb-gradient-page); min-height: 100vh; }
.avatar-section { display: flex; flex-direction: column; align-items: center; padding: 40rpx 0; background: var(--mb-card-bg); margin-bottom: 20rpx; }
.avatar-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 16rpx;
  position: relative;
  flex-shrink: 0;
}
.edit-avatar {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
  vertical-align: top;
}
.avatar-btn {
  position: absolute;
  left: 0;
  top: 0;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  width: 100%;
  height: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  border-radius: 0;
  line-height: 0;
  font-size: 0;
  opacity: 0;
  z-index: 2;
}
.avatar-btn::after {
  border: none;
  background: none;
}
.avatar-tip { font-size: 26rpx; color: var(--mb-text-muted); }
.form-group { background: var(--mb-card-bg); padding: 0 30rpx; margin-bottom: 40rpx; }
.form-item { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid var(--mb-border-subtle); }
.form-label { width: 120rpx; font-size: 30rpx; color: var(--mb-text-primary); flex-shrink: 0; }
.form-input { flex: 1; font-size: 30rpx; color: var(--mb-text-primary); text-align: right; }
.save-btn {
  width: calc(100% - 60rpx);
  margin: 0 auto;
  height: 96rpx;
  background: #2E8B57;
  color: #fff;
  font-size: 32rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.save-btn::after { border: none; }
