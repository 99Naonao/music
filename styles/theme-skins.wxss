/**
 * 主题皮肤 · CSS 变量由 page-meta 按主题注入（与 utils/theme.js 一致）
 * 全站页面壳：mb-page / mb-page-bg / mb-page-body
 */

.mb-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
}

.mb-page-bg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.mb-theme-dawn .mb-page-bg {
  background: linear-gradient(135deg, #d1e9ff 0%, #e8f4ff 42%, #f7faff 72%, #ffffff 100%);
}

.mb-theme-night .mb-page-bg {
  background:
    radial-gradient(ellipse 120% 60% at 50% -8%, rgba(111, 143, 207, 0.35) 0%, transparent 55%),
    linear-gradient(180deg, #202b48 0%, #2d3a5c 45%, #1a2238 100%);
}

.mb-page-body {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
}
