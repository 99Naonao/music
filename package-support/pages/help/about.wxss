.about-page {
  min-height: 100vh;
    padding: 32rpx 30rpx 80rpx;
  box-sizing: border-box;
}

.about-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 40rpx;
}

.about-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
}

.about-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--mb-text-primary);
  margin-bottom: 12rpx;
}

.about-slogan {
  font-size: 26rpx;
  color: var(--mb-text-muted);
}

.about-card {
  background: var(--mb-card-bg);
  border: 1rpx solid var(--mb-card-border);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.about-card.muted {
  background: rgba(255, 255, 255, 0.03);
}

.about-lead {
  font-size: 28rpx;
  color: var(--mb-text-secondary);
  line-height: 1.65;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  margin-bottom: 20rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feature-item {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--mb-border-subtle);
}

.feature-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.feature-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2e8b57;
  margin-bottom: 8rpx;
}

.feature-desc {
  display: block;
  font-size: 26rpx;
  color: var(--mb-text-secondary);
  line-height: 1.5;
}

.legal-line {
  font-size: 24rpx;
  color: var(--mb-text-muted);
  line-height: 1.55;
}

.about-footer {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 16rpx;
}

.version-text {
  font-size: 24rpx;
  color: var(--mb-text-muted);
  text-align: center;
}

.copyright {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.28);
}
