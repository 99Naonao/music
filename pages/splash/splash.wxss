.splash-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 48rpx 80rpx;
  /* 与 page-meta 一致：左上 → 右下 */
  background: linear-gradient(135deg, #d1e9ff 0%, #e8f4ff 42%, #f7faff 72%, #ffffff 100%);
}

.splash-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  opacity: 0;
  transform: translateY(24rpx);
  transition: opacity 0.55s ease, transform 0.55s ease;
}

.splash-body-in {
  opacity: 1;
  transform: translateY(0);
}

.splash-hero-wrap {
  width: 440rpx;
  height: 440rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.splash-hero {
  width: 100%;
  height: 100%;
}

.splash-title {
  color: rgb(25, 63, 163);
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.splash-subtitle {
  color: rgb(93, 134, 202);
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.splash-slogan {
  font-size: 26rpx;
  font-weight: 200;
}

/* 晨雾浅蓝 · 与设计稿一致 */
.splash-page--dawn .splash-title {
  color: #1e3a5f;
}

.splash-page--dawn .splash-subtitle {
  color: #4a6fa5;
}

.splash-page--dawn .splash-slogan {
  color: #7a8fa8;
}

/* 眠夜深蓝 */
.splash-page--night .splash-title {
  color: #fffdf5;
}

.splash-page--night .splash-subtitle {
  color: rgba(245, 245, 240, 0.82);
}

.splash-page--night .splash-slogan {
  color: rgba(245, 245, 240, 0.55);
}
