.gift-inbox-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.gift-inbox-header {
  padding: 24rpx 30rpx 16rpx;
}

.gift-inbox-count {
  font-size: 26rpx;
  color: var(--mb-text-secondary);
  line-height: 1.5;
}

.gift-inbox-loading {
  text-align: center;
  padding: 80rpx 32rpx;
  font-size: 28rpx;
  color: var(--mb-text-muted);
}

.gift-inbox-list {
  padding: 0 20rpx;
}

.gift-inbox-item {
  display: flex;
  align-items: flex-start;
  background: var(--mb-card-bg);
  border: 1rpx solid var(--mb-card-border);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.gift-inbox-cover {
  width: 100rpx;
  height: 130rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: rgba(111, 143, 207, 0.12);
}

.gift-inbox-info {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}

.gift-inbox-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gift-inbox-sub {
  display: block;
  font-size: 24rpx;
  color: var(--mb-text-secondary);
  margin-bottom: 8rpx;
}

.gift-inbox-preview {
  display: block;
  font-size: 24rpx;
  color: var(--mb-text-muted);
  line-height: 1.45;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.gift-inbox-time {
  display: block;
  font-size: 22rpx;
  color: var(--mb-text-muted);
}

.gift-inbox-remove {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #c0392b;
  padding: 8rpx 0 8rpx 12rpx;
}

.gift-inbox-empty {
  text-align: center;
  padding: 100rpx 48rpx;
}

.gift-inbox-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  margin-bottom: 16rpx;
}

.gift-inbox-empty-hint {
  display: block;
  font-size: 26rpx;
  color: var(--mb-text-muted);
  line-height: 1.55;
}
