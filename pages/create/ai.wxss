.ai-page {
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.ai-page-bg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.mb-theme-dawn .ai-page-bg {
  background: linear-gradient(135deg, #d1e9ff 0%, #e8f4ff 42%, #f7faff 72%, #ffffff 100%);
}

.mb-theme-night .ai-page-bg {
  background: linear-gradient(180deg, #202b48 0%, #2d3a5c 45%, #1a2238 100%);
}

.ai-page-header {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
}

.ai-nav {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 24rpx 20rpx;
}

.ai-nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-nav-back-icon {
  font-size: 52rpx;
  line-height: 1;
  color: var(--mb-text-primary);
  font-weight: 300;
}

.ai-nav-center {
  flex: 1;
  text-align: center;
  padding: 0 8rpx;
}

.ai-nav-placeholder {
  width: 64rpx;
  flex-shrink: 0;
}

.ai-nav-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--mb-text-primary);
  line-height: 1.3;
}

.ai-nav-sub {
  display: block;
  font-size: 24rpx;
  color: var(--mb-text-secondary);
  margin-top: 8rpx;
  line-height: 1.4;
}

.ai-scroll {
  flex: none;
  width: 100%;
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

.ai-scroll-inner {
  padding: 0 32rpx 32rpx;
}

.prompt-card {
  position: relative;
  background: var(--mb-card-bg);
  border: 1rpx solid var(--mb-card-border);
  border-radius: 24rpx;
  padding: 28rpx 28rpx 52rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 58, 95, 0.06);
}

.prompt-editor {
  position: relative;
  min-height: 220rpx;
}

/* 框内示例文案（比原生 placeholder 更易多行、对齐） */
.prompt-hint {
  position: absolute;
  left: 0;
  top: 0;
  right: 72rpx;
  z-index: 0;
  pointer-events: none;
}

.prompt-hint-line {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: rgba(30, 58, 95, 0.38);
}

.mb-theme-night .prompt-hint-line {
  color: rgba(245, 245, 240, 0.42);
}

.prompt-input {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 220rpx;
  min-height: 220rpx;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--mb-text-primary);
  box-sizing: border-box;
  background: transparent;
}

.prompt-count {
  position: absolute;
  right: 28rpx;
  bottom: 20rpx;
  font-size: 22rpx;
  color: var(--mb-text-muted);
  z-index: 2;
  pointer-events: none;
}

.block {
  margin-bottom: 36rpx;
}

.block-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  margin-bottom: 20rpx;
}

.scene-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.scene-chip {
  width: calc((100% - 48rpx) / 4);
  box-sizing: border-box;
  padding: 20rpx 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--mb-text-secondary);
  background: var(--mb-card-bg);
  border: 2rpx solid var(--mb-card-border);
  border-radius: 20rpx;
}

.scene-chip--on {
  color: #2d5a8e;
  background: rgba(111, 143, 207, 0.18);
  border-color: rgba(111, 143, 207, 0.45);
  font-weight: 600;
}

.mb-theme-night .scene-chip--on {
  color: var(--mb-text-primary);
  background: var(--mb-mint-20);
  border-color: var(--mb-mist-blue);
}

.scene-chip--toggle {
  color: var(--mb-mist-blue);
  font-weight: 500;
}

.scene-chip--active {
  opacity: 0.88;
  transform: scale(0.97);
}

.mood-scroll {
  width: 100%;
}

.mood-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0 8rpx;
}

.mood-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  background: var(--mb-card-bg);
  border: 2rpx solid var(--mb-card-border);
  flex-shrink: 0;
}

.mood-chip--on {
  background: rgba(111, 143, 207, 0.18);
  border-color: rgba(111, 143, 207, 0.45);
}

.mood-emoji {
  font-size: 28rpx;
}

.mood-label {
  font-size: 26rpx;
  color: var(--mb-text-secondary);
}

.mood-chip--on .mood-label {
  color: var(--mb-text-primary);
  font-weight: 600;
}

.ai-bottom {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(255, 255, 255, 0.95) 70%, transparent);
}

.mb-theme-night .ai-bottom {
  background: linear-gradient(to top, rgba(26, 34, 56, 0.98) 70%, transparent);
}

.ai-submit {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: var(--mb-btn-primary, var(--mb-gradient-cta));
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx var(--mb-btn-shadow, rgba(111, 143, 207, 0.35));
}

.ai-submit::after {
  border: none;
}
