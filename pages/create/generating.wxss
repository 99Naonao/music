.generating-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
}

.generating-page-bg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  background: var(--mb-gradient-page);
}

.generating-body {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 48rpx 32rpx;
  box-sizing: border-box;
}

.generating-scroll {
  position: relative;
  z-index: 1;
}

.generating-scroll-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 48rpx 24rpx;
  box-sizing: border-box;
}

.generating-body--error {
  justify-content: center;
}

.gen-header {
  width: 100%;
  text-align: center;
  margin-top: 16rpx;
  margin-bottom: 48rpx;
}

.gen-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

.gen-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--mb-text-muted);
  line-height: 1.5;
}

.gen-subtitle--error {
  color: #c45c5c;
  font-size: 24rpx;
  padding: 0 16rpx;
  text-align: left;
}

.mb-theme-night .gen-subtitle--error {
  color: rgba(255, 180, 180, 0.95);
}

/* 中心 Logo */
.gen-hero {
  position: relative;
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gen-hero-glow {
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(86, 143, 209, 0.22) 0%, rgba(86, 143, 209, 0.06) 55%, transparent 72%);
  animation: gen-glow 3s ease-in-out infinite;
}

.mb-theme-night .gen-hero-glow {
  background: radial-gradient(circle, rgba(230, 199, 106, 0.18) 0%, rgba(111, 143, 207, 0.1) 50%, transparent 72%);
}

@keyframes gen-glow {
  0%,
  100% {
    transform: scale(0.94);
    opacity: 0.75;
  }
  50% {
    transform: scale(1.05);
    opacity: 1;
  }
}

.gen-hero-img {
  position: relative;
  z-index: 1;
  width: 300rpx;
  height: 300rpx;
  animation: gen-float 4.5s ease-in-out infinite;
}

@keyframes gen-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}

/* 进度区 */
.gen-progress-block {
  width: 100%;
  max-width: 620rpx;
  flex: 1;
}

.gen-progress-label {
  display: block;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  margin-bottom: 36rpx;
  font-variant-numeric: tabular-nums;
}

.gen-track {
  position: relative;
  padding: 0 8rpx 56rpx;
}

.gen-track-rail {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  top: 18rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(30, 58, 95, 0.12);
  overflow: hidden;
}

.mb-theme-night .gen-track-rail {
  background: rgba(255, 253, 245, 0.12);
}

.gen-track-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--mb-btn-primary);
  transition: width 0.35s ease;
}

.mb-theme-night .gen-track-fill {
  background: linear-gradient(90deg, #6f8fcf 0%, #7fb3a3 100%);
}

.gen-nodes {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  z-index: 1;
}

.gen-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 33.33%;
  flex-shrink: 0;
}

.gen-node-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(30, 58, 95, 0.12);
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  margin-bottom: 12rpx;
  transition: background 0.3s ease, box-shadow 0.3s ease;
}

.mb-theme-night .gen-node-dot {
  background: rgba(255, 253, 245, 0.15);
  border-color: rgba(45, 58, 92, 0.8);
}

.gen-node--on .gen-node-dot {
  background: var(--mb-btn-primary);
  box-shadow: 0 0 0 6rpx var(--mb-accent-soft, rgba(86, 143, 209, 0.25));
}

.mb-theme-night .gen-node--on .gen-node-dot {
  background: #7fb3a3;
  box-shadow: 0 0 0 6rpx rgba(127, 179, 163, 0.25);
}

.gen-node-label {
  font-size: 24rpx;
  color: var(--mb-text-muted);
  text-align: center;
  line-height: 1.35;
}

.gen-node--on .gen-node-label {
  color: var(--mb-text-primary);
  font-weight: 600;
}

.gen-status {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--mb-text-muted);
  margin-top: 8rpx;
}

/* 底部按钮 */
.gen-footer-fixed {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 12rpx 48rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid rgba(107, 122, 140, 0.1);
}

.mb-theme-night .gen-footer-fixed {
  background: rgba(26, 34, 56, 0.98);
  border-top-color: rgba(255, 255, 255, 0.08);
}

.gen-footer {
  width: 100%;
  max-width: 620rpx;
  margin-top: auto;
  padding-top: 32rpx;
}

.gen-cancel-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  margin: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: var(--mb-btn-primary, #568fd1);
  border: none;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx var(--mb-btn-shadow, rgba(86, 143, 209, 0.35));
}

.gen-cancel-btn::after {
  border: none;
}

.gen-footer-fixed--stack {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.gen-footer-fixed--stack .gen-error-actions {
  margin-top: 0;
}

.gen-error-actions {
  width: 100%;
  max-width: 620rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin: 0 auto;
}

.gen-outline-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  font-size: 30rpx;
  color: var(--mb-text-secondary);
  background: transparent;
  border: 1rpx solid var(--mb-border-strong);
  border-radius: 44rpx;
}

.gen-outline-btn::after {
  border: none;
}
