<page-meta page-style="{{pageMetaStyle}}" />
<wxs src="./blessing-preview.wxs" module="bp" />
<view class="mb-page mb-theme-{{mbTheme}}">
  <view class="mb-page-bg"></view>
  <view class="mb-page-body share-page">
  <!-- P0：礼物感说明（与完成页 / 分享卡一致） -->
  <view class="share-gift-strip">
    <text class="share-gift-title">晚安贺卡</text>
    <text class="share-gift-sub" wx:if="{{isSharedView}}">你收到一份专属晚安礼，试听后可为自己或 TA 制作</text>
    <text class="share-gift-sub" wx:else>好友打开即可看到你的祝福并试听这首曲子</text>
  </view>

  <!-- 音乐播放器 -->
  <view class="share-player-section">
    <view class="share-cover-container">
      <view class="share-cover">
        <image wx:if="{{musicCoverImage}}" class="share-cover-img" src="{{musicCoverImage}}" mode="aspectFill"/>
        <view wx:else class="share-cover-default">
          <image class="share-cover-default-icon" src="/static/music_library/panel.png" mode="aspectFit"/>
        </view>
        <view class="share-cover-overlay">
          <view class="share-play-btn" bindtap="togglePlay">
            <image class="play-btn-icon" src="{{isPlaying ? '/static/new_logo/pause.png' : '/static/new_logo/play.png'}}" mode="aspectFit"/>
          </view>
        </view>
      </view>
    </view>
    <text class="share-music-title">{{shareWorkTitle}}</text>
    <text class="share-music-info">{{musicInfo.instrument}} · {{musicInfo.frequency}} · {{musicInfo.bpm}}BPM</text>
    <view class="share-progress">
      <view class="share-progress-bar" style="width: {{currentTime/duration*100}}%"></view>
    </view>
    <view class="share-time">
      <text>{{formatTime(currentTime)}}</text>
      <text>{{formatTime(duration)}}</text>
    </view>
  </view>

  <!-- 贺卡预览 -->
  <view class="share-card-section">
    <view class="share-card style-{{cardData.template}} {{cardData.artistBgImage || cardCustomCover ? 'with-art-bg' : ''}}">
      <block wx:if="{{cardCustomCover}}">
        <view class="share-card-art-frame">
          <image class="share-card-bg-photo" src="{{cardCustomCover}}" mode="widthFix"/>
          <view class="share-to-slot" style="{{cardOverlayStyle.to}}">
            <text class="share-to-line card-art-text-stroke" style="font-size: {{shareToFontSize}}rpx;">TO: {{cardData.recipient || '亲爱的朋友'}}</text>
          </view>
          <view class="share-card-content share-card-content--art" style="{{cardOverlayStyle.message}}">
            <view class="share-card-message-wrap" style="font-size: {{shareMsgFontSize}}rpx;">
              <block wx:for="{{shareMessageLines}}" wx:key="index">
                <view wx:if="{{item === ''}}" class="share-card-message-gap"></view>
                <text wx:else class="share-card-message-line card-art-text-stroke">{{item}}</text>
              </block>
            </view>
          </view>
        </view>
      </block>
      <block wx:elif="{{cardData.artistBgImage}}">
        <view class="share-card-art-frame">
          <image class="share-card-bg-photo" src="{{cardData.artistBgImage}}" mode="widthFix"/>
          <view class="share-to-slot" style="{{cardOverlayStyle.to}}">
            <text class="share-to-line card-art-text-stroke" style="font-size: {{shareToFontSize}}rpx;">TO: {{cardData.recipient || '亲爱的朋友'}}</text>
          </view>
          <view class="share-card-content share-card-content--art" style="{{cardOverlayStyle.message}}">
            <view class="share-card-message-wrap" style="font-size: {{shareMsgFontSize}}rpx;">
              <block wx:for="{{shareMessageLines}}" wx:key="index">
                <view wx:if="{{item === ''}}" class="share-card-message-gap"></view>
                <text wx:else class="share-card-message-line card-art-text-stroke">{{item}}</text>
              </block>
            </view>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="share-card-bg"></view>
        <view class="share-card-content">
          <view class="share-card-to">致 <text>{{cardData.recipient || '亲爱的朋友'}}</text>：</view>
          <view class="share-card-message-wrap share-card-message-wrap--gradient" style="font-size: {{shareMsgFontSize}}rpx;">
            <block wx:for="{{shareMessageLines}}" wx:key="index">
              <view wx:if="{{item === ''}}" class="share-card-message-gap"></view>
              <text wx:else class="share-card-message-line">{{item}}</text>
            </block>
          </view>
          <view class="share-card-from">—— <text>眠音盒</text></view>
        </view>
      </block>
    </view>
  </view>

  <!-- 隐藏 canvas 用于生成贺卡图片 -->
  <canvas canvas-id="cardCanvas" style="width: 750px; height: 1200px; position: fixed; left: -9999px; top: 0;"/>

  <view class="share-footer">
    <block wx:if="{{isSharedView}}">
      <view class="share-footer-invite">
        <button class="share-btn-invite-create" bindtap="goToCreateFromGift">
          <view class="share-invite-btn-inner">
            <text class="share-invite-btn-title">我也要制作</text>
            <text class="share-invite-btn-sub">分享贺卡得积分</text>
          </view>
        </button>
      </view>
      <text class="share-points-hint" wx:if="{{canShare}}">点击分享并发送给好友，每日可得 3 积分</text>
      <view class="share-footer-actions">
        <button
          wx:if="{{canShare}}"
          class="share-btn share-btn--primary"
          open-type="share"
          bindtap="onShareCardTap"
        >分享小程序卡片</button>
        <button
          wx:else
          class="share-btn share-btn--primary"
          bindtap="goLogin"
        >分享小程序卡片</button>
        <button class="share-btn share-btn--outline" bindtap="goBack">返回首页</button>
      </view>
    </block>
    <block wx:else>
      <text class="share-points-hint" wx:if="{{canShare}}">点击分享并发送给好友，每日可得 3 积分</text>
      <view class="share-footer-actions">
        <button
          wx:if="{{canShare}}"
          class="share-btn share-btn--primary"
          open-type="share"
          bindtap="onShareCardTap"
        >分享小程序卡片</button>
        <button
          wx:else
          class="share-btn share-btn--primary"
          bindtap="goLogin"
        >分享小程序卡片</button>
        <button class="share-btn share-btn--outline" bindtap="goBack">返回首页</button>
      </view>
      <view class="share-footer-prev">
        <button class="share-btn-prev-full" bindtap="goBackPrevious">‹ 返回上一页</button>
      </view>
    </block>
  </view>
  </view>
  <points-reward-modal id="points-reward-modal" />
</view>
