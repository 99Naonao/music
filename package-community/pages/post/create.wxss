.create-post {
  min-height: 100vh;
    padding: 0 30rpx 60rpx;
}

.content-input {
  width: 100%;
  height: 300rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--mb-text-primary);
  background: transparent;
}

/* placeholder-class 内 var() 常不生效，须按主题写死色值（同 ai 页 prompt-hint） */
.input-ph-dawn {
  color: rgba(30, 58, 95, 0.42);
}

.input-ph-night {
  color: rgba(245, 245, 240, 0.48);
}

.word-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: var(--mb-text-muted);
  margin-bottom: 30rpx;
}

/* 图片区域 */
.image-section {
  margin-bottom: 40rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: var(--mb-card-bg);
}

.remove-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(255,107,107,0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  width: 22rpx;
  height: 22rpx;
}

.add-image {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--mb-border-strong);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-image:active {
  border-color: var(--mb-mint-40);
  background: rgba(46,139,87,0.05);
}

.add-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: var(--mb-text-muted);
}

/* 话题选择 */
.topic-section {
  margin-bottom: 40rpx;
}

.section-label {
  font-size: 28rpx;
  color: var(--mb-text-secondary);
  display: block;
  margin-bottom: 20rpx;
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-tag {
  padding: 14rpx 28rpx;
  background: var(--mb-card-bg);
  color: var(--mb-text-secondary);
  font-size: 26rpx;
  border-radius: 32rpx;
  border: 1rpx solid transparent;
}

.topic-tag.active {
  background: var(--mb-mint-15);
  color: var(--mb-mint);
  border-color: var(--mb-mint-30);
}

.topic-tag:active {
  opacity: 0.7;
}

/* 关联作品 */
.work-section {
  margin-bottom: 40rpx;
}

.work-add {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  background: var(--mb-card-bg);
  border-radius: 16rpx;
  border: 2rpx dashed var(--mb-border-strong);
}

.work-add:active {
  background: var(--mb-card-bg);
}

.work-add-icon {
  width: 40rpx;
  height: 40rpx;
}

.work-add-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--mb-text-primary);
  font-weight: 500;
}

.work-add-arrow {
  font-size: 24rpx;
  color: var(--mb-text-muted);
}

.work-selected {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--mb-mint-08);
  border-radius: 16rpx;
  border: 1rpx solid var(--mb-mint-20);
}

.work-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.work-icon {
  width: 40rpx;
  height: 40rpx;
}

.work-text {
  display: flex;
  flex-direction: column;
}

.work-title {
  font-size: 28rpx;
  color: var(--mb-text-primary);
}

.work-meta {
  font-size: 22rpx;
  color: var(--mb-text-muted);
  margin-top: 4rpx;
}

.work-remove {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 作品选择弹层 */
.work-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
}

.work-picker {
  width: 100%;
  background: var(--mb-bg-elevated);
  border-radius: 32rpx 32rpx 0 0;
  padding: 30rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(30, 58, 95, 0.12);
}

.mb-theme-night .work-picker {
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.35);
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  text-align: center;
  margin-bottom: 24rpx;
}

.picker-list {
  max-height: 500rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid var(--mb-border-subtle);
}

.picker-item:active {
  background: var(--mb-border-subtle);
}

.picker-icon {
  width: 36rpx;
  height: 36rpx;
}

.picker-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.picker-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--mb-text-primary);
  line-height: 1.4;
  word-break: break-all;
}

.picker-meta {
  font-size: 22rpx;
  color: var(--mb-text-secondary);
  margin-top: 6rpx;
}

.picker-close {
  text-align: center;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--mb-text-primary);
  margin-top: 16rpx;
  opacity: 0.85;
}

.picker-close:active {
  opacity: 0.7;
}

/* 底部发布按钮 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 30rpx 40rpx;
  background: linear-gradient(to top, var(--mb-night-fade-80) 60%, transparent);
  border-top: 1rpx solid var(--mb-border-subtle);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: var(--mb-gradient-cta);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx var(--mb-btn-shadow);
}

.submit-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.submit-btn:active {
  opacity: 0.8;
}
