.gift-relay {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: #e8f2fc;
}

.gift-relay-box {
  width: 100%;
  text-align: center;
}

.gift-relay-title {
  display: block;
  font-size: 32rpx;
  color: #2d5a8e;
  line-height: 1.6;
}

.gift-relay-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7a8c;
}

.gift-relay-btn {
  margin-top: 32rpx;
  width: 100%;
  background: #2d5a8e;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
}

.gift-relay-btn.ghost {
  background: transparent;
  color: #2d5a8e;
  border: 1rpx solid #2d5a8e;
}
