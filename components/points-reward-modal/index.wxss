.prm-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10050;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(30, 58, 95, 0);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.25s ease, background 0.25s ease;
}

.prm-mask--show {
  background: rgba(30, 58, 95, 0.48);
  pointer-events: auto;
  opacity: 1;
}

.prm-card {
  width: 100%;
  max-width: 560rpx;
  padding: 48rpx 40rpx 40rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  text-align: center;
  background: linear-gradient(165deg, #fffdf8 0%, #ffffff 55%, #f3faf7 100%);
  border: 1rpx solid rgba(212, 175, 55, 0.22);
  box-shadow: 0 24rpx 64rpx rgba(30, 58, 95, 0.18);
  transform: scale(0.88) translateY(24rpx);
  opacity: 0;
  transition: transform 0.28s cubic-bezier(0.34, 1.2, 0.64, 1), opacity 0.25s ease;
}

.prm-card--show {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.prm-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #8a6b1a;
  background: rgba(212, 175, 55, 0.14);
  letter-spacing: 2rpx;
}

.prm-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1e3a5f;
  line-height: 1.4;
  margin-bottom: 28rpx;
}

.prm-points-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  margin-bottom: 16rpx;
}

.prm-points-sign {
  font-size: 40rpx;
  font-weight: 700;
  color: #d4af37;
  line-height: 1;
}

.prm-points-num {
  font-size: 88rpx;
  font-weight: 700;
  color: #d4af37;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.prm-points-unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(30, 58, 95, 0.72);
}

.prm-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(30, 58, 95, 0.55);
  line-height: 1.5;
  margin-bottom: 36rpx;
}

.prm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  border: none;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #7fb3a3 0%, #568fd1 100%);
  box-shadow: 0 12rpx 28rpx rgba(86, 143, 209, 0.32);
}

.prm-btn::after {
  border: none;
}

.prm-btn:active {
  opacity: 0.92;
}
