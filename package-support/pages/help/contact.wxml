<page-meta page-style="{{pageMetaStyle}}" />
<view class="mb-page mb-theme-{{mbTheme}}">
  <view class="mb-page-bg"></view>
  <view class="mb-page-body contact-container">
  <view class="contact-card">
    <view class="contact-item">
      <text class="contact-label">客服电话</text>
      <view class="contact-row">
        <text class="contact-value">400-808-5180</text>
        <text class="contact-action" bindtap="callPhone">拨打</text>
      </view>
    </view>
    <view class="contact-item">
      <text class="contact-label">客服邮箱</text>
      <view class="contact-row">
        <text class="contact-value">support@music.com</text>
        <text class="contact-action" bindtap="copyEmail">复制</text>
      </view>
    </view>
    <view class="contact-item">
      <text class="contact-label">服务时间</text>
      <text class="contact-value">周一至周日 9:00-21:00</text>
    </view>
  </view>

  <button class="contact-btn" open-type="contact">在线客服</button>
  </view>
</view>
