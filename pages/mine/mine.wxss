.mine-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
}

.mine-body {
  position: relative;
  z-index: 1;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 未登录 */
.mine-login-card {
  margin-top: 16rpx;
  margin-bottom: 24rpx;
  padding: 48rpx 32rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  border: 1rpx solid var(--mb-card-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(30, 58, 95, 0.06);
}

.mb-theme-night .mine-login-card {
  background: var(--mb-card-bg);
  box-shadow: none;
}

.mine-login-avatar {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
}

.mine-login-tip {
  font-size: 28rpx;
  color: var(--mb-text-secondary);
  margin-bottom: 32rpx;
}

.btn-wechat-login {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #07c160, #05a350);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 60rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-wechat-login::after {
  border: none;
}

/* 资料区 */
.mine-profile {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 0 28rpx;
}

.mine-profile-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.avatar-container {
  position: relative;
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
}

.avatar-circle {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 16rpx rgba(86, 143, 209, 0.2);
  flex-shrink: 0;
}

.mb-theme-night .avatar-circle {
  border-color: rgba(255, 255, 255, 0.15);
  box-shadow: none;
}

.user-avatar {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
  vertical-align: top;
}

/* 透明按钮仅负责点击选头像，避免原生 chooseAvatar 按钮自带异形裁剪 */
.avatar-choose-btn {
  position: absolute;
  left: 0;
  top: 0;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  width: 100%;
  height: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  border-radius: 0;
  line-height: 0;
  font-size: 0;
  opacity: 0;
  z-index: 2;
}

.avatar-choose-btn::after {
  border: none;
  background: none;
}

.avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 40rpx;
  height: 40rpx;
  background: #568fd1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #fff;
}

.mb-theme-night .avatar-edit {
  background: linear-gradient(135deg, #7fb3a3, #6f8fcf);
  border-color: #1a2238;
}

.avatar-edit-icon {
  width: 20rpx;
  height: 20rpx;
}

.mine-profile-text {
  flex: 1;
  min-width: 0;
}

.user-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--mb-text-primary);
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-id {
  display: block;
  font-size: 24rpx;
  color: var(--mb-text-muted);
}

.mine-profile-settings {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.mine-profile-settings:active {
  opacity: 0.7;
}

.mine-settings-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.75;
}

/* 五列统计 */
.mine-stats {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 8rpx 0 32rpx;
  gap: 8rpx;
}

.mine-stat-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.mine-stat-item:active {
  opacity: 0.75;
}

.mine-stat-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--mb-text-primary);
  line-height: 1.2;
  margin-bottom: 8rpx;
  font-variant-numeric: tabular-nums;
}

.mine-stat-num--points {
  color: #c9a227;
}

.mb-theme-night .mine-stat-num--points {
  color: #e6c76a;
}

.mine-stat-label {
  font-size: 22rpx;
  color: var(--mb-text-muted);
  line-height: 1.3;
}

/* 菜单卡片 */
.mine-menu-card {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--mb-card-border);
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(30, 58, 95, 0.05);
}

.mb-theme-night .mine-menu-card {
  background: var(--mb-card-bg);
  box-shadow: none;
}

.mine-menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--mb-border-subtle);
}

.mine-menu-item--last {
  border-bottom: none;
}

.mine-menu-item:active {
  background: rgba(86, 143, 209, 0.08);
}

.mb-theme-night .mine-menu-item:active {
  background: rgba(255, 255, 255, 0.05);
}

.mine-menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: transparent;
}

.mine-menu-icon {
  width: 60rpx;
  height: 60rpx;
}

.mine-menu-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--mb-text-primary);
}

.mine-menu-extra {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mine-menu-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  background: #e74c3c;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 32rpx;
}

.mine-menu-arrow {
  font-size: 36rpx;
  color: var(--mb-text-muted);
  font-weight: 300;
  line-height: 1;
}

.mine-bottom-space {
  height: 24rpx;
}
