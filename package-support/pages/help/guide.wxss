.guide-container { background: var(--mb-gradient-page); min-height: 100vh; padding: 30rpx; }
.guide-step { display: flex; }
.step-left { display: flex; flex-direction: column; align-items: center; width: 60rpx; margin-right: 24rpx; }
.step-num { width: 48rpx; height: 48rpx; background: var(--mb-mint); color: var(--mb-text-primary); border-radius: 50%; text-align: center; line-height: 48rpx; font-size: 24rpx; }
.step-line { flex: 1; width: 2rpx; background: rgba(255,255,255,0.1); margin: 8rpx 0; }
.step-right { flex: 1; padding-bottom: 40rpx; }
.step-title { display: block; font-size: 32rpx; color: var(--mb-text-primary); font-weight: 600; margin-bottom: 8rpx; }
.step-desc { display: block; font-size: 28rpx; color: var(--mb-text-secondary); line-height: 1.5; }
