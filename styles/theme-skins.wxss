/**
 * 主题皮肤 · 页面壳（参考 pillow：page 纯色 + 容器 height 100%，Android 不用 100vh 撑高）
 */

.mb-page {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.mb-page-bg,
.create-home-bg,
[class$='-page-bg'] {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
  background-color: var(--mb-bg-page);
  background-image: var(--mb-gradient-page);
}

.mb-page-body {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
  height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* 覆盖各页 wxss 里写在 mb-page-body 上的 min-height:100vh，避免与 flex 滚动高度冲突导致滑到底顿一下 */
.mb-page > .mb-page-body {
  min-height: 0;
}

/* 页内已有纵向 scroll-view（固定头+列表）时，避免双层滚动 */
.mb-page-body.mb-page-body--nested-scroll {
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.mb-page-chrome {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
  background-color: var(--mb-bg-page);
  background-image: var(--mb-gradient-page);
}

/* 底部固定操作条：半透明 + 主题色，避免纯白/深灰条与渐变脱节 */
.mb-footer-surface {
  background: var(--mb-night-fade-95, var(--mb-bg-elevated));
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-top: 1rpx solid var(--mb-border-subtle);
  box-sizing: border-box;
}

/* 底部手势条区域由 mb-bottom-safe（非 Tab 页）或 custom-tab-bar 安全区填充 */
