.player-page {
  display: flex;
  flex-direction: column;
  padding: 0 40rpx 0;
  box-sizing: border-box;
}

.player-nav {
  flex-shrink: 0;
}

.player-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.player-back-icon {
  font-size: 56rpx;
  line-height: 1;
  color: var(--mb-text-primary);
  font-weight: 300;
}

.player-header {
  text-align: center;
  padding: 8rpx 16rpx 32rpx;
  flex-shrink: 0;
}

.player-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--mb-text-primary);
  margin-bottom: 20rpx;
  line-height: 1.35;
}

.player-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.player-tag {
  padding: 8rpx 22rpx;
  font-size: 24rpx;
  color: var(--mb-text-secondary);
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(86, 143, 209, 0.22);
  border-radius: 28rpx;
}

.mb-theme-night .player-tag {
  background: rgba(255, 255, 255, 0.08);
  border-color: var(--mb-card-border);
}

.player-disc-wrap {
  position: relative;
  width: 480rpx;
  height: 480rpx;
  margin: 0 auto 48rpx;
  flex-shrink: 0;
}

.player-disc-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 400rpx;
  height: 400rpx;
  margin-left: -200rpx;
  margin-top: -200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(86, 143, 209, 0.28) 0%, transparent 68%);
}

.player-disc {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    0 16rpx 48rpx rgba(86, 143, 209, 0.25),
    0 0 0 12rpx rgba(86, 143, 209, 0.08);
}

.mb-theme-night .player-disc {
  border-color: rgba(255, 255, 255, 0.15);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
}

.player-disc--spin {
  animation: player-disc-rotate 24s linear infinite;
}

@keyframes player-disc-rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.player-disc-img {
  width: 100%;
  height: 100%;
  display: block;
}

.player-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
  flex-shrink: 0;
}

.player-time {
  font-size: 24rpx;
  color: var(--mb-text-muted);
  min-width: 80rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.player-slider {
  flex: 1;
}

.player-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin-bottom: 56rpx;
  flex-shrink: 0;
}

.player-ctrl-side {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-ctrl-side--loop {
  width: 80rpx;
  height: auto;
  min-height: 72rpx;
  flex-direction: column;
  gap: 4rpx;
}

.player-loop-label {
  font-size: 18rpx;
  line-height: 1.2;
  color: var(--mb-text-muted);
  max-width: 80rpx;
  text-align: center;
  white-space: nowrap;
}

.player-loop-label--on {
  color: var(--mb-mist-blue, #568fd1);
  font-weight: 600;
}

.player-ctrl-side:active {
  opacity: 0.7;
}

.player-ctrl-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.85;
}

.player-ctrl-icon--sm {
  width: 48rpx;
  height: 48rpx;
}

.player-ctrl-icon--on {
  opacity: 1;
  filter: none;
}

.mb-theme-dawn .player-ctrl-icon--on {
  opacity: 1;
}

.player-ctrl-play {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  box-shadow: none;
}

.player-ctrl-play:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.player-ctrl-play-icon {
  width: 80rpx;
  height: 80rpx;
}

.player-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
  flex-shrink: 0;
}

.player-action-btn {
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: var(--mb-text-primary);
  background: rgba(111, 143, 207, 0.12);
  border-radius: 32rpx;
}

.player-action-btn:active {
  opacity: 0.85;
}

.player-action-btn--ghost {
  background: transparent;
  color: var(--mb-text-muted);
  border: 1rpx solid rgba(107, 122, 140, 0.25);
}

.player-toolbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  margin-top: auto;
  padding-top: 8rpx;
  flex-shrink: 0;
}

.player-tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  min-width: 120rpx;
}

.player-tool:active {
  opacity: 0.75;
}

.player-tool-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.75;
}

.player-tool-icon--on {
  opacity: 1;
}

.mb-theme-dawn .player-tool-icon--on {
  opacity: 1;
  filter: saturate(1.2);
}

.player-tool-label {
  font-size: 24rpx;
  color: var(--mb-text-muted);
}

.player-tool-label--on {
  color: var(--mb-mist-blue, #568fd1);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.player-mianjia-tip {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 28rpx;
  padding: 20rpx 56rpx 20rpx 24rpx;
  border-radius: 999rpx;
  background: var(--mb-mint-08);
  border: 1rpx solid var(--mb-border-subtle);
  flex-shrink: 0;
}

.player-mianjia-close {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.player-mianjia-close-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.55;
}

.player-mianjia-close:active .player-mianjia-close-icon {
  opacity: 0.85;
}

.player-mianjia-tip:active {
  opacity: 0.85;
}

.player-mianjia-text {
  font-size: 26rpx;
  color: var(--mb-text-secondary);
}

.player-mianjia-arrow {
  font-size: 28rpx;
  color: var(--mb-mint);
  font-weight: 500;
}
