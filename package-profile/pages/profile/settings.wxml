<page-meta
  page-style="{{pageMetaStyle}}"
  background-color="{{mbPageBg}}"
  background-color-top="{{mbNavBg}}"
  background-color-bottom="{{mbPageBg}}"
  root-background-color="{{mbPageBg}}"
/>
<mb-bottom-safe />
<view class="mb-page mb-theme-{{mbTheme}}" style="{{pageShellStyle}}">
  <view class="mb-page-chrome" style="{{pageBgStyle}}"></view>
  <view class="mb-page-bg" style="{{pageBgStyle}}"></view>
  <view class="mb-page-body settings-container">

  <view class="setting-group">
    <view class="setting-item" bindtap="goToEdit">
      <text class="item-label">编辑资料</text>
      <text class="item-arrow">›</text>
    </view>
    <view class="setting-item" bindtap="goToAccountSecurity">
      <text class="item-label">账户与安全</text>
      <text class="item-arrow">›</text>
    </view>
    <view class="setting-item setting-item--last">
      <text class="item-label">通知设置</text>
      <switch class="item-switch" checked color="{{mbAccent}}"/>
    </view>
  </view>

  <!-- 外观主题（官方 16 套 / 渠道 14 套，不含官方经典） -->
  <view class="setting-group setting-group--theme">
    <view class="setting-section-title">外观主题</view>
    <scroll-view class="theme-scroll" scroll-x enable-flex show-scrollbar="{{false}}" scroll-left="{{themeScrollLeft}}">
      <view class="theme-scroll-inner">
        <view
          wx:for="{{appearanceThemeOptions}}"
          wx:key="id"
          class="theme-card {{appearanceThemePresetId === item.id ? 'theme-card--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectAppearanceTheme"
        >
          <view
            class="theme-card-preview"
            style="background: linear-gradient(165deg, {{item.windowBg}} 0%, {{item.navBg}} 48%, {{item.primaryColor}} 100%);"
          ></view>
          <text class="theme-card-name">{{item.name}}</text>
          <text class="theme-card-desc">{{item.desc}}</text>
          <view wx:if="{{appearanceThemePresetId === item.id}}" class="theme-card-check">✓</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="setting-group">
    <view class="setting-item" bindtap="goToAbout">
      <text class="item-label">关于我们</text>
      <text class="item-arrow">›</text>
    </view>
    <view class="setting-item setting-item--last" bindtap="goToHelp">
      <text class="item-label">帮助中心</text>
      <text class="item-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{isLoggedIn}}" class="logout-wrap">
    <button class="btn-logout" bindtap="logout">退出登录</button>
  </view>

  </view>
</view>
