<page-meta
  page-style="{{pageMetaStyle}}"
  background-color="{{mbPageBg}}"
  background-color-top="{{mbNavBg}}"
  background-color-bottom="{{mbPageBg}}"
  root-background-color="{{mbPageBg}}"
/>
<mb-bottom-safe />
<view class="mb-page mb-theme-{{mbTheme}}" style="{{pageShellStyle}}">
  <view class="mb-page-chrome" style="{{pageBgStyle}}"></view>
  <view class="mb-page-bg" style="{{pageBgStyle}}"></view>
  <view class="mb-page-body ph-container">
    <view class="ph-header">
      <text class="ph-count" wx:if="{{items.length}}">共 {{items.length}} 条</text>
      <text class="ph-count" wx:else>暂无记录</text>
      <text class="ph-clear {{items.length ? '' : 'ph-clear--disabled'}}" bindtap="onClearAll">清空</text>
    </view>

    <view class="ph-list">
      <view
        class="ph-item"
        wx:for="{{items}}"
        wx:key="id"
        bindtap="onTapItem"
        data-index="{{index}}"
      >
        <image
          class="ph-cover"
          src="{{item.cover}}"
          mode="aspectFill"
          binderror="onCoverError"
          data-index="{{index}}"
        />
        <view class="ph-info">
          <text class="ph-title">{{item.title}}</text>
          <view class="ph-tags" wx:if="{{item.tags.length}}">
            <text class="ph-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
          </view>
          <text class="ph-time">{{item.timeText}}</text>
        </view>
        <view class="ph-meta">
          <text class="ph-duration" wx:if="{{item.durationText}}">{{item.durationText}}</text>
          <image class="ph-play-icon" src="/static/new_logo/play.png" mode="aspectFit" />
        </view>
      </view>

      <view class="ph-empty" wx:if="{{!loading && items.length === 0}}">
        <text class="ph-empty-title">还没有播放记录</text>
        <text class="ph-empty-hint">在首页、曲库或播放页收听后会自动记在这里</text>
      </view>
    </view>
  </view>
</view>
