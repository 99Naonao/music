.mj-detail {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.mj-detail-notice {
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 243, 224, 0.92);
  border: 1rpx solid rgba(230, 162, 60, 0.35);
}

.mj-detail-notice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #b8741a;
  margin-bottom: 8rpx;
}

.mj-detail-notice-text {
  display: block;
  font-size: 24rpx;
  color: #8a6a3a;
  line-height: 1.55;
}

.mj-detail-img {
  width: 100%;
  height: 520rpx;
  border-radius: 24rpx;
  background: var(--mb-card-bg);
}

.mj-detail-info {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--mb-card-bg);
  border: 1rpx solid var(--mb-card-border);
}

.mj-detail-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mb-text-primary);
  line-height: 1.45;
}

.mj-detail-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--mb-text-secondary);
  line-height: 1.55;
}

.mj-detail-id {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--mb-text-muted);
}

.mj-detail-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 28rpx;
}

.mj-detail-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.mj-detail-btn::after {
  border: none;
}

.mj-detail-btn--primary {
  color: #fff;
  background: linear-gradient(135deg, var(--mb-mint), #5a9a88);
}

.mj-detail-btn--secondary {
  color: var(--mb-text-primary);
  background: var(--mb-card-bg);
  border: 1rpx solid var(--mb-card-border);
}

.mj-detail-btn--ghost {
  color: var(--mb-text-muted);
  background: transparent;
  border: none;
  font-size: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.mj-detail-voucher-link {
  display: block;
  text-align: center;
  margin-top: 4rpx;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: var(--mb-text-muted);
}

.mj-detail-voucher-link:active {
  opacity: 0.65;
}

.mj-detail-loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--mb-text-muted);
}
