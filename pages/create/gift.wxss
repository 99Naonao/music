@import './share.wxss';

/* 收礼页：播放/暂停仅图标，无圆底/渐变 */
.gift-play-btn {
  width: auto;
  height: auto;
  padding: 0;
  margin: 0;
  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;
  border: none;
  border-radius: 0;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gift-play-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

.gift-play-btn-icon {
  width: 72rpx;
  height: 72rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.35));
}

.gift-progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  padding: 8rpx 4rpx 0;
  box-sizing: border-box;
}

.gift-time {
  font-size: 24rpx;
  color: var(--mb-text-muted);
  min-width: 72rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.gift-slider {
  flex: 1;
}
