.posts-container { background: var(--mb-gradient-page); min-height: 100vh; padding: 20rpx; }
.post-item { background: var(--mb-card-bg); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.post-text { display: block; font-size: 30rpx; color: var(--mb-text-primary); line-height: 1.5; margin-bottom: 16rpx; }
.post-imgs { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.post-imgs image { width: 200rpx; height: 200rpx; border-radius: 12rpx; background: var(--mb-card-bg); }
.post-bottom { display: flex; justify-content: space-between; align-items: center; }
.post-time { font-size: 24rpx; color: var(--mb-text-muted); }
.post-bottom-right { display: flex; align-items: center; gap: 24rpx; }
.post-stats { display: flex; gap: 24rpx; align-items: center; }
.post-stats text { font-size: 24rpx; color: var(--mb-text-muted); }
.post-stat-icon { width: 24rpx; height: 24rpx; }
.post-delete { font-size: 26rpx; color: #ff6b6b; padding: 8rpx 12rpx; }
